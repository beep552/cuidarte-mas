# Copia este archivo como `.env` y define tus propios valores.
# NUNCA versiones el `.env` real (véase .gitignore).
# HAL-03: los secretos son obligatorios; no hay valores por defecto.

# Clave de firma JWT (mínimo 32 caracteres aleatorios):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Credenciales de la base (rotar tras cada incidente)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=cuidarteplus

# Puertos
PORT_BACKEND=4444
PORT_FRONTEND=3333

# Entorno
NODE_ENV=production
